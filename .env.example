# 環境変数の見本。.env.local にコピーして値を入れる（.env.local はコミットしない）
# ローカルの値は `npx supabase status` で確認できる

# ブラウザに渡してよいのはこの2つだけ（NEXT_PUBLIC_ を付けてよいのは Supabase の URL と anon key のみ）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 以下はサーバー側だけで使う秘密情報。NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=
# 開発ではテスト用チャンネルの Webhook を使う（本番の URL を入れない）
DISCORD_WEBHOOK_URL=
# 定期実行APIの認証用。長いランダム文字列（例：openssl rand -hex 32）
CRON_SECRET=
